# ---------------------------------------------------------------
# ctf-watch settings.  start.sh creates .env from this file.
# ---------------------------------------------------------------

# Where the CTF app is. Normally LEAVE EMPTY: you pick it in the dashboard (CTFs tab),
# which lists every listening port and container on the VM, and you can switch at any time.
# Set it only to skip that step, e.g. CTF_TARGET=http://127.0.0.1:5000
CTF_TARGET=

# Port the proxy listens on. Point zrok at THIS port (not the CTF port).
PROXY_PORT=8888

# Which address the proxy listens on.
#   127.0.0.1 = only this VM can reach it (fine when zrok runs on this VM)
#   0.0.0.0   = anyone on the network can reach it (only if zrok runs elsewhere)
PROXY_BIND=127.0.0.1

# Dashboard port and address. 127.0.0.1 = only this VM (use an SSH tunnel from your laptop).
# The dashboard now has a login, so you MAY set DASHBOARD_BIND=0.0.0.0 to reach it over the LAN,
# but it must never be shared through zrok.
DASHBOARD_PORT=8080
DASHBOARD_BIND=127.0.0.1

# Dashboard accounts are generated fresh on every start and printed by start.sh:
# one admin (admin_xxx) plus this many "user_N" viewer accounts.
DASHBOARD_USERS=3
# Hours of inactivity before a dashboard session expires.
SESSION_TTL_HOURS=12

# Name of this CTF (one record per event in the database). Empty = "ctf-<date>".
# Changing it (or "New CTF" in the dashboard) starts a fresh event; old ones stay queryable.
CTF_NAME=

# Ask every student for their name the first time they open the CTF in a browser?
#   0 = no (default). Students are identified from the app's login / cookies / IP.
#   1 = yes. A small "What's your name?" page appears once, then the name is shown
#       on the dashboard instead of the app username. The CTF itself is not changed.
NAME_GATE=0
NAME_GATE_TITLE="Welcome to the CTF"

# Start the zrok share automatically?  1 = yes (default), 0 = no, I will run zrok myself.
# start.sh finds zrok2 (or the old zrok) and runs:   zrok2 share public --headless <PROXY_PORT>
ZROK_AUTO=1

# Fixed share name (optional), so the link stays the same every time.
#   zrok2:  create it once with   zrok2 create name <name>   then put <name> here
#   zrok 1: the name of your reserved share
ZROK_RESERVED=

# Only if zrok is installed somewhere unusual: full path to the zrok2 / zrok binary.
ZROK_BIN=

# Log level: info | debug
LOG_LEVEL=info
